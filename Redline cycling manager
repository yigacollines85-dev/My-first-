    <!-- JavaScript Logic -->
    <script>
        // Set default date input to today
        document.getElementById('rideDate').valueAsDate = new Date();

        // Local Storage State Key
        const STORAGE_KEY = 'velolog_rides_data';
        let rides = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
        let currentSelectedRide = null;

        // Initialize UI
        window.onload = function() {
            renderDashboard();
            if (rides.length > 0) {
                loadRideToStoryCard(rides[0]);
            }
        };

        // Tab Switching Logic
        function switchTab(tab) {
            ['log', 'stats', 'card'].forEach(t => {
                document.getElementById(`sec-${t}`).classList.add('hidden');
                document.getElementById(`tab-${t}`).className = "flex-1 py-2.5 rounded-xl font-bold text-sm transition flex items-center justify-center gap-2 text-slate-400 hover:text-white";
            });

            document.getElementById(`sec-${tab}`).classList.remove('hidden');
            document.getElementById(`tab-${tab}`).className = "flex-1 py-2.5 rounded-xl font-bold text-sm transition flex items-center justify-center gap-2 bg-emerald-500 text-slate-950 shadow-md";
        }

        // Live Speed Calculation
        function calculateLiveSpeed() {
            const dist = parseFloat(document.getElementById('rideDistance').value) || 0;
            const hrs = parseFloat(document.getElementById('rideHours').value) || 0;
            const mins = parseFloat(document.getElementById('rideMinutes').value) || 0;

            const totalHours = hrs + (mins / 60);
            if (dist > 0 && totalHours > 0) {
                const speed = (dist / totalHours).toFixed(1);
                document.getElementById('liveSpeedText').innerText = `${speed} km/h`;
            } else {
                document.getElementById('liveSpeedText').innerText = `0.0 km/h`;
            }
        }

        // Save Ride Handler
        function saveRide(e) {
            e.preventDefault();

            const date = document.getElementById('rideDate').value;
            const distance = parseFloat(document.getElementById('rideDistance').value);
            const hours = parseInt(document.getElementById('rideHours').value) || 0;
            const minutes = parseInt(document.getElementById('rideMinutes').value) || 0;
            const elevation = parseInt(document.getElementById('rideElevation').value) || 0;
            const zone = document.getElementById('rideZone').value;
            const location = document.getElementById('rideLocation').value;
            const highlight = document.getElementById('rideHighlight').value;

            const totalHours = hours + (minutes / 60);
            const avgSpeed = totalHours > 0 ? (distance / totalHours).toFixed(1) : "0.0";

            const newRide = {
                id: Date.now(),
                date,
                distance,
                hours,
                minutes,
                elevation,
                zone,
                location,
                highlight,
                avgSpeed
            };

            rides.unshift(newRide);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(rides));

            // Reset Form
            document.getElementById('rideForm').reset();
            document.getElementById('rideDate').valueAsDate = new Date();
            document.getElementById('liveSpeedText').innerText = `0.0 km/h`;

            // Update UI & View
            renderDashboard();
            loadRideToStoryCard(newRide);
            showToast("Ride saved successfully!");
            switchTab('card');
        }

        // Render Dashboard Stats & History
        function renderDashboard() {
            const listEl = document.getElementById('ridesList');
            document.getElementById('rideCountBadge').innerText = `${rides.length} rides`;

            if (rides.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-8 text-slate-500 text-sm">
                        <i class="fa-solid fa-bicycle text-3xl mb-2 opacity-40"></i>
                        <p>No rides logged yet. Start by logging your first ride!</p>
                    </div>
                `;
                document.getElementById('statTotalDist').innerHTML = `0.0 <span class="text-sm font-normal text-slate-400">km</span>`;
                document.getElementById('statTotalElev').innerHTML = `0 <span class="text-sm font-normal text-slate-400">m</span>`;
                document.getElementById('statAvgSpeed').innerHTML = `0.0 <span class="text-sm font-normal text-slate-400">km/h</span>`;
                return;
            }

            // Calculations
            let totalDist = 0;
            let totalElev = 0;
            let totalHoursSum = 0;

            listEl.innerHTML = '';

            rides.forEach(ride => {
                totalDist += ride.distance;
                totalElev += ride.elevation;
                totalHoursSum += (ride.hours + (ride.minutes / 60));

                const item = document.createElement('div');
                item.className = "bg-slate-800/60 border border-slate-700/60 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3";
                item.innerHTML = `
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="font-extrabold text-white text-base">${ride.location}</span>
                            <span class="text-xs text-slate-400 bg-slate-900 px-2 py-0.5 rounded-md border border-slate-700">${ride.date}</span>
                        </div>
                        <div class="text-xs text-slate-300 flex items-center gap-3">
                            <span><i class="fa-solid fa-road text-emerald-400"></i> ${ride.distance} km</span>
                            <span><i class="fa-solid fa-clock text-cyan-400"></i> ${ride.hours}h ${ride.minutes}m</span>
                            <span><i class="fa-solid fa-bolt text-yellow-400"></i> ${ride.avgSpeed} km/h</span>
                            <span><i class="fa-solid fa-mountain text-emerald-400"></i> ${ride.elevation}m</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                        <button onclick='selectRideForStory(${ride.id})' class="text-xs bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-3 py-1.5 rounded-lg font-bold transition">
                            <i class="fa-solid fa-share mr-1"></i> Story
                        </button>
                        <button onclick='deleteRide(${ride.id})' class="text-xs bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 px-2.5 py-1.5 rounded-lg transition">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
                listEl.appendChild(item);
            });

            const overallAvgSpeed = totalHoursSum > 0 ? (totalDist / totalHoursSum).toFixed(1) : "0.0";

            document.getElementById('statTotalDist').innerHTML = `${totalDist.toFixed(1)} <span class="text-sm font-normal text-slate-400">km</span>`;
            document.getElementById('statTotalElev').innerHTML = `${totalElev} <span class="text-sm font-normal text-slate-400">m</span>`;
            document.getElementById('statAvgSpeed').innerHTML = `${overallAvgSpeed} <span class="text-sm font-normal text-slate-400">km/h</span>`;
        }

        // Load Ride Data to Story Card & Caption Box
        function loadRideToStoryCard(ride) {
            currentSelectedRide = ride;
            document.getElementById('cardDate').innerText = ride.date;
            document.getElementById('cardLocation').innerText = ride.location;
            document.getElementById('cardHighlight').innerText = ride.highlight ? `"${ride.highlight}"` : '"Pushing boundaries on two wheels!"';
            document.getElementById('cardDist').innerText = `${ride.distance} km`;
            document.getElementById('cardSpeed').innerText = `${ride.avgSpeed} km/h`;
            document.getElementById('cardElev').innerText = `${ride.elevation} m`;
            document.getElementById('cardZone').innerHTML = `<i class="fa-solid fa-heart-pulse text-red-400 mr-1"></i> ${ride.zone}`;

            // Generate Social Caption Text
            const caption = `🚴 Ride Update from the road!
📍 Location: ${ride.location}
📏 Distance: ${ride.distance} km
⏱️ Time: ${ride.hours}h ${ride.minutes}m
🚀 Avg Speed: ${ride.avgSpeed} km/h
🏔️ Elevation Gain: ${ride.elevation}m
🔥 Intensity: ${ride.zone}

💬 Story: ${ride.highlight || 'Another epic day grinding miles and exploring new roads.'}

#cycling #bikelife #biketouring #cyclist #roadbike #training #travel`;

            document.getElementById('captionBox').value = caption;
        }

        function selectRideForStory(id) {
            const ride = rides.find(r => r.id === id);
            if (ride) {
                loadRideToStoryCard(ride);
                switchTab('card');
                showToast("Loaded to Story Card preview");
            }
        }

        function deleteRide(id) {
            rides = rides.filter(r => r.id !== id);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(rides));
            renderDashboard();
            showToast("Ride deleted");
        }

        // Copy Caption Function
        function copyCaption() {
            const captionText = document.getElementById('captionBox');
            captionText.select();
            document.execCommand('copy');
            showToast("Caption copied to clipboard!");
        }

        // Toast Helper
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
